<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projeto Tarefas</title>
    <!-- Bootstrap via CDN só pra deixar bonito, sem precisar instalar nada -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Projeto Tarefas</a>
                <ul class="navbar-nav flex-grow-1">
                    @* O menu muda dependendo se o usuário está logado ou não *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Tarefas" asp-action="Index">Minhas Tarefas</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center me-3">
                            <span class="text-white">Olá, @User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Conta" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Conta" asp-action="Login">Entrar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Conta" asp-action="Cadastro">Cadastrar</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        @* TempData["Mensagem"] é usado pra avisos rápidos, tipo "cadastro feito com sucesso" *@
        @if (TempData["Mensagem"] != null)
        {
            <div class="alert alert-success">@TempData["Mensagem"]</div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @* jQuery + validação client-side, pra mostrar os erros do [Required] etc SEM recarregar a página *@
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
