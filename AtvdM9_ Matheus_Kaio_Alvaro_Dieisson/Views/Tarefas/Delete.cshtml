@model Tarefa
@{
    ViewData["Title"] = "Excluir Tarefa";
}

<h2>Excluir Tarefa</h2>
<hr />
<div class="alert alert-danger">Tem certeza que deseja excluir esta tarefa?</div>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">Data</dt>
    <dd class="col-sm-10">@Model.Data.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@(Model.Concluida ? "Concluída" : "Pendente")</dd>
</dl>



<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sim, excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
